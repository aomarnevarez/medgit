{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medgit.dev/schema/commit-0.2.0.json",
  "title": "MedGit commit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "medgit",
    "kind",
    "type",
    "author",
    "authored_at",
    "recorded_at",
    "message",
    "parents",
    "episode_id",
    "resources",
    "sensitivity",
    "corrects",
    "notices"
  ],
  "properties": {
    "medgit": { "const": "0.2.0" },
    "kind": { "const": "commit" },
    "type": {
      "enum": [
        "patient-init",
        "episode-open",
        "episode-abandon",
        "note",
        "order",
        "result",
        "observation",
        "medication",
        "procedure",
        "feature",
        "correction",
        "inference",
        "merge"
      ]
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "display": { "type": "string", "minLength": 1 },
        "role": { "enum": ["resident", "attending", "system", "auditor"] }
      }
    },
    "authored_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "recorded_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "message": { "type": "string", "minLength": 1 },
    "parents": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "episode_id": { "type": ["string", "null"] },
    "resources": { "type": "array", "items": { "type": "object" } },
    "sensitivity": { "enum": ["normal", "restricted"] },
    "corrects": { "type": ["string", "null"] },
    "notices": { "type": "array" }
  }
}
